# ============================================================
# JETTY™ — Environment Configuration
# The Pauli Effect | Emerald Tablets™
# ============================================================
# Copy to .env and fill in at least one AI API key.
# Keys NEVER leave this server. Browser never sees them.
# All secrets managed here — no keys in code.
# ============================================================

# App identity
APP_NAME=JETTY™
APP_REGION=Salt Lake City, Utah
APP_TAGLINE=Your private AI second brain for work that matters.

# ============================================================
# AI PROVIDERS — default test path is OpenRouter Auto
# MODEL_PROVIDER controls the default.
# For now, use OpenRouter through the existing OpenAI-compatible
# Synthia gateway path so we avoid the slow LLaMA/Groq default.
# ============================================================
MODEL_PROVIDER=synthia

# OpenRouter Auto — one key, model router, good for early demos
# Docs: https://openrouter.ai/docs/quickstart
SYNTHIA_GATEWAY_BASE_URL=https://openrouter.ai/api/v1
SYNTHIA_GATEWAY_API_KEY=
SYNTHIA_GATEWAY_MODEL=openrouter/auto

# Optional OpenRouter identity headers can be used by a future backend pass.
# The current backend does not require them.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=JETTY™

# Anthropic Claude — Best reasoning | console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI GPT | platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq — backup only. Do not use LLaMA as the default demo path.
GROQ_API_KEY=
GROQ_MODEL=

# Mistral — optional fallback | console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# DeepSeek — optional fallback | platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini — for Vision Mode | aistudio.google.com
GEMINI_API_KEY=

# ============================================================
# OPTIONAL: INTEGRATIONS (via Composio)
# ============================================================
COMPOSIO_API_KEY=

# ============================================================
# SUPABASE AUTH
# ============================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ============================================================
# SYSTEM CONFIGURATION
# ============================================================
NOTES_DIR=./notes
RATE_LIMIT_PER_MINUTE=45
MAX_HISTORY=10
DAILY_COST_LIMIT_USD=25
PORT=4700
HOST=0.0.0.0

# ============================================================
# SECRETS MANAGEMENT (Infisical — recommended for production)
# All production keys should live in Infisical vault
# never in this file when committed to version control
# ============================================================
# INFISICAL_API_KEY=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENV=prod
